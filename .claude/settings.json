{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/SandyStudio/.claude/hooks/mode-validator.cjs\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/SandyStudio/.claude/hooks/naming-validator.cjs\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/SandyStudio/.claude/hooks/locked-status-guard.cjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "git add -A && { git diff --cached --quiet || { git commit -m \"auto-sync $(date '+%Y-%m-%d %H:%M')\" && BR=$(git symbolic-ref --short HEAD 2>/dev/null) && case \"$BR\" in claude/*) git push origin \"$BR\" ;; *) : ;; esac; }; } 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  }
}

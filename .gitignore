# Local media staging buffer — never commit generated video/image/audio files
Staging/

# Film projects — each film is its own non-git project (Director's q2 decision 2026-04-25)
# Studio repo = tools. Films = content. Do not couple.
FILMS/**
# EXCEPT the design text. Директор 30.07: «чтобы не потерять стиль Глубины». Причина не
# гигиена, а инцидент: 29.07 две сессии независимо построили один и тот же мир второго
# жанра — FILMS/ невидим в git, и одна сессия физически не могла увидеть работу другой.
# Медиа по-прежнему не коммитим. В git идёт только .md: замысел, канон, банки идей.
!FILMS/**/
!FILMS/**/*.md
# ...но НЕ из кэшей и служебных папок: там лежат файлы с расширением .md, внутри которых
# бинарь на полтора мегабайта (FILMS/_media_cache/SS-*-LOCKED.md). Расширение врёт, размер
# нет — проверять по `git diff --cached --stat`, а не по имени.
FILMS/_media_cache/
FILMS/_inngest/
# Отчёты и логи ежедневного прогона HoG (hog-daily.ps1) — одно место хранения ВНЕ git
# (Директор 15.08: «чтобы при росте веток не рос мусор»). 2 МБ за три недели против 815 КБ
# у снимков, и каждое дерево несло бы свою копию. html/md регенерируются из снимков и
# уезжают в gist, лог одноразовый. Снимки — наоборот, В git: малы, невосстановимы и несут
# поля, которых в БД нет (показы, CTR, средний процент досмотра).
FILMS/_distribution/
# Узкое исключение: утверждённый канон серии в виде СЖАТЫХ референс-копий (~100–150 КБ).
# Стиль — это картинки; текст один его не сохраняет, а генерация недетерминирована, то есть
# утверждённый кадр невоспроизводим. Полноразмерные мастера уходят на Drive штатным путём,
# когда кадр становится ассетом Библии. Только эта папка, только jpg.
!FILMS/*/canon/
!FILMS/*/canon/*.jpg

# Claude Code worktrees from parallel sessions
.claude/worktrees/

# Local durable change journal (change-journal.cjs hook) — per-machine breadcrumb that
# survives /clear; churns on every edit, so keep it out of git.
.claude/CHANGES.md

# Per-machine permission overrides. Untracked 2026-07-17: this was committed, so the
# laptop and the desktop fought over ONE file whose entries are machine-specific by
# nature (absolute paths, worktree names, per-box tool locations) — it had silently
# accumulated cruft from three different machine identities, and the recurring
# "local-claude-settings" stash was that fight. Claude Code's own convention is that
# settings.local.json is local; settings.json stays tracked for shared config.
# Last tracked content: commit 2f94b16e (restore a machine's copy from there if lost).
.claude/settings.local.json

# Environment variables
.env
.env.local
.env.*.local
# Keep the template committed (explicit allow as a safety net)
!.env.example

# Node / webapp (when Sprint 9 begins)
node_modules/
.next/
out/

# Project-local junk
*.tmp.json
archive/_dead/

# OS
.DS_Store
Thumbs.db

# Build artifact — regenerated by tsc, never commit (was tracked by mistake)
*.tsbuildinfo

# Env backups (contain secrets) — keep local, never commit
.env*.bak-*
.env*.bak

# Dev server log
.next-dev.log

# Worktree-independent local media cache (heavy binaries, never commit)
webapp/SandyStudioFILMS_media_cache/

# Uncommitted-work backup patches (per-session breadcrumbs, like .claude/CHANGES.md)
.claude/*.patch
.claude/*-snapshot.patch

# One-off diagnostic / poll / recovery scripts from live episode runs (E12–E16).
# Session-specific throwaways, not tooling — kept local, out of git.
webapp/scripts/diag-*
webapp/scripts/poll-*
webapp/scripts/watch-*
webapp/scripts/reconcile-e*
webapp/scripts/recover-e*
webapp/scripts/fix-e*
webapp/scripts/finish-e*
webapp/scripts/check-e*
webapp/scripts/dump-e*
webapp/scripts/rerender-e*
webapp/scripts/update-e*-metadata.ts
webapp/scripts/e1*-economics.ts
webapp/scripts/test-one-critic.ts
webapp/scripts/wait-router.ts
# E17/E19 live-run throwaways (same policy — session diagnostics, kept local)
webapp/scripts/e17-*
webapp/scripts/e19-*
# In-repo session handover/scout notes from live runs (breadcrumbs, not tooling)
.claude/e17-*.md

# Runtime logs (app / inngest / build / dist) — never commit
webapp/*.log

inngest.log
prod.log
.claude/.run-guard-state.json

# Local media staging buffer — never commit generated video/image/audio files
Staging/

# Film projects — each film is its own non-git project (Director's q2 decision 2026-04-25)
# Studio repo = tools. Films = content. Do not couple.
FILMS/

# Claude Code worktrees from parallel sessions
.claude/worktrees/

# Local durable change journal (change-journal.cjs hook) — per-machine breadcrumb that
# survives /clear; churns on every edit, so keep it out of git.
.claude/CHANGES.md

# Environment variables
.env
.env.local
.env.*.local
# Keep the template committed (explicit allow as a safety net)
!.env.example

# Node / webapp (when Sprint 9 begins)
node_modules/
.next/
out/

# Project-local junk
*.tmp.json
archive/_dead/

# OS
.DS_Store
Thumbs.db

# Build artifact — regenerated by tsc, never commit (was tracked by mistake)
*.tsbuildinfo

# Env backups (contain secrets) — keep local, never commit
.env*.bak-*
.env*.bak

# Dev server log
.next-dev.log

# Worktree-independent local media cache (heavy binaries, never commit)
webapp/SandyStudioFILMS_media_cache/

# Uncommitted-work backup patches (per-session breadcrumbs, like .claude/CHANGES.md)
.claude/*.patch
.claude/*-snapshot.patch

# One-off diagnostic / poll / recovery scripts from live episode runs (E12–E16).
# Session-specific throwaways, not tooling — kept local, out of git.
webapp/scripts/diag-*
webapp/scripts/poll-*
webapp/scripts/watch-*
webapp/scripts/reconcile-e*
webapp/scripts/recover-e*
webapp/scripts/fix-e*
webapp/scripts/finish-e*
webapp/scripts/check-e*
webapp/scripts/dump-e*
webapp/scripts/rerender-e*
webapp/scripts/update-e*-metadata.ts
webapp/scripts/e1*-economics.ts
webapp/scripts/test-one-critic.ts
webapp/scripts/wait-router.ts

# ──────────────────────────────────────────────────────────────────────────────
# SandyStudio — .env.example
# Copy this to `.env` and fill in real values (NEVER commit .env).
#
# Per CLAUDE.md §11 «ARCHITECTURE RULES»: NO HARDCODING, ENV FIRST.
# Per specs/system/api_integrations.md §10: full credential map below.
#
# Status: TEMPLATE  |  Source of truth: api_integrations.md §10
# ──────────────────────────────────────────────────────────────────────────────


# ═══ STORAGE PATHS ════════════════════════════════════════════════════════════
# Storage roots live in app_config (scope 'storage': project_root,
# media_storage_root) — managed via Settings UI / /api/storage/config.
# No env vars: the old STORAGE_* names were never read by code.


# ═══ VIDEO PROVIDERS ══════════════════════════════════════════════════════════
# Veo 3 via Google Vertex AI.
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Note: regional allowlist applies; project must have Vertex AI enabled.
GOOGLE_VGEN_API_KEY=

# Kling 3.0 Elements API (primary character video provider — D-001).
# Get from: kling.kuaishou.com / klingai.com developer portal
KLING_API_KEY=

# Runway Gen-4 (fallback video provider).
# Get from: dev.runwayml.com → API Keys
RUNWAY_API_KEY=

# fal.ai unified gateway (Flux, upscale, etc.) — heavily used.
# Get from: fal.ai/dashboard/keys
FAL_AI_KEY=


# ═══ IMAGE PROVIDERS ══════════════════════════════════════════════════════════
# Flux Pro — primary image provider (via fal.ai or direct).
# If using fal.ai: FAL_AI_KEY above is sufficient. Set FLUX_API_KEY only if direct.
FLUX_API_KEY=

# Replicate (Flux, SDXL fallbacks).
# Get from: replicate.com/account/api-tokens
REPLICATE_API_KEY=


# ═══ MUSIC / AUDIO ════════════════════════════════════════════════════════════
# Beatoven.ai — primary music provider (mood-based, royalty-free).
# Get from: beatoven.ai → developer settings
BEATOVEN_API_KEY=

# ElevenLabs — SFX and Voice (single key for both).
# Get from: elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Suno (UNOFFICIAL — fallback of last resort, requires Director flag in providers.yaml).
SUNO_API_KEY=

# Udio (UNOFFICIAL — fallback of last resort).
UDIO_API_KEY=


# ═══ DISTRIBUTION — YOUTUBE ═══════════════════════════════════════════════════
# OAuth client is the shared GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (one GCP
# client, multiple scopes). Per-channel refresh tokens (multi-channel.md §3):
#   YOUTUBE_REFRESH_TOKEN_<CREDENTIAL_KEY>   e.g. YOUTUBE_REFRESH_TOKEN_SANDY
# Obtain via: npx tsx webapp/scripts/youtube-consent.ts --key <KEY>
# Legacy bare name (= SANDY channel token, transition period):
YOUTUBE_REFRESH_TOKEN=


# ═══ FUTURE PROVIDERS (Sprint 8+) ═════════════════════════════════════════════
# Cartesia TTS (planned voice provider).
CARTESIA_API_KEY=

# Topaz Video AI (planned upscale / 4K pipeline).
TOPAZ_API_KEY=


# ═══ SUPABASE (webapp.md §9) ══════════════════════════════════════════════════
# Cloud project: created in https://supabase.com/dashboard
# Get from: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. NEVER prefix with NEXT_PUBLIC_. Used by Inngest worker via service-role bypass of RLS.
SUPABASE_SERVICE_ROLE_KEY=


# ═══ INNGEST (webapp.md §9) ═══════════════════════════════════════════════════
# Local dev: leave EVENT_KEY empty; the Inngest dev server signs locally.
# Production (cloud Inngest or self-hosted): get keys from Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# ═══ APP CONFIG (webapp.md §9) ════════════════════════════════════════════════
# Absolute URL of the running app (used by Inngest webhook callbacks, OAuth redirects).
# Local-first dev default: http://localhost:3000
# Tailscale: http://sandystudio.tail-XXXXX.ts.net:3000  (per webapp.md §2.1)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ═══ OPENAI (PRIMARY for the Studio Concierge — agents/exec/concierge.md) ════
# Get from: https://platform.openai.com/api-keys
# Used by: webapp /api/concierge/chat (server-side only; never NEXT_PUBLIC_).
OPENAI_API_KEY=
# Override the chat model. Per developers.openai.com/api/docs/models:
#   gpt-5.5         — coding/reasoning, expensive ($5 / $30 per MTok)
#   gpt-5.4         — affordable coding/professional ($2.50 / $15)
#   gpt-5.4-mini    — fastest, cheapest frontier ($0.75 / $4.50)  ← Concierge default
# Legacy: gpt-4o, gpt-4o-mini, gpt-4.1.
OPENAI_MODEL=gpt-5.4-mini
# Tunables (all optional).
# Max tokens in the response (default 2000).
OPENAI_MAX_OUTPUT_TOKENS=2000
# Reasoning effort for gpt-5 family: none | low | medium | high | xhigh.
# Ignored for legacy chat models (gpt-4o etc.).
OPENAI_REASONING_EFFORT=low
# Sampling temperature 0.0–2.0. Ignored by gpt-5 family (uses default).
OPENAI_TEMPERATURE=0.2

# ═══ ANTHROPIC (optional — kept for future cost routing per BOARD-FIN policy) ═
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# ═══ OPERATIONAL FLAGS ════════════════════════════════════════════════════════
# System mode (CLAUDE.md §6). ALWAYS starts as ===1=== regardless of value here.
# This var documents intended persistent default; runtime mode lives in PLAN.md.
SANDYSTUDIO_MODE====1===

# Governance mode (CLAUDE.md §6). Default Mode 1 (MANUAL).
# Allowed: "Mode 1" | "Mode 2" | "Mode 3" | "Mode 4"
GOVERNANCE_MODE=Mode 1


# ═══ COST LIMITS (BOARD-FIN enforces) ═════════════════════════════════════════
# Hard ceilings in USD. BOARD-FIN blocks API calls that would exceed these.
EPISODE_BUDGET_USD=50.00
SESSION_BUDGET_USD=10.00


# ──────────────────────────────────────────────────────────────────────────────
# REMINDERS
# - Director-only secrets. Do NOT share or commit `.env`.
# - When rotating a key: update value here, then restart Claude Code session.
# - Per api_integrations.md §10, system Windows ENV vars are also acceptable —
#   `.env` is for project-local overrides and onboarding documentation.
# - Missing required ENV at agent startup → FAIL FAST (architecture rule #5).
# ──────────────────────────────────────────────────────────────────────────────
